{
  "rootDir": "./workspace",
  "permissions": {
    "files": "read-write",
    "terminal": true
  },
  "terminal": {
    "shell": "auto",
    "allowedCommands": [
      "pwd",
      "ls",
      "dir",
      "grep",
      "find",
      "cat",
      "type",
      "echo",
      "ps",
      "nl",
      "printf",
      "where",
      "Get-ChildItem"
    ],
    "timeoutMs": 10000,
    "maxOutputBytes": 20000,
    "env": {},
    "cwd": null
  },
  "transport": "stdio",
  "http": {
    "host": "127.0.0.1",
    "port": 8080
  },
  "public": {
    "enabled": false,
    "provider": "cloudflared",
    "authToken": "change-me"
  },
  "oauth": {
    "enabled": false,
    "issuer": null,
    "clients": [
      {
        "clientId": "my-client",
        "clientSecret": "my-secret",
        "redirectUris": ["http://localhost:3000/callback"]
      }
    ],
    "tokenExpirySeconds": 3600
  },
  "sensitivePatterns": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "id_rsa",
    "id_ed25519",
    ".npmrc",
    ".aws/credentials",
    ".ssh/*"
  ],
  "allowSensitive": false,
  "dashboard": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 7821
  },
  "logging": {
    "actions": true,
    "file": "mcp-actions.log"
  }
}
